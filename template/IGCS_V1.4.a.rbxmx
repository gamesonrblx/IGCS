   | || | |_ | |     \___ \
  _| || |__| | |____ ____) |
 |_____\_____|\_____|_____/

 IGCS ??In-Game Chat System

    Server-IGCS_AdonisPlugin
    Child of IGCS_AdminBridge - auto-placed to Adonis_Loader > Config > Plugins
]]

return function(Vargs)
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local bridgeModule = ReplicatedStorage:WaitForChild("IGCS_AdminBridge", 10)
	if not bridgeModule then
		warn("[IGCS] Could not find IGCS_AdminBridge in ReplicatedStorage")
		return
	end

	local Bridge = require(bridgeModule)
	Bridge.HookAdonis(Vargs)

	print("[IGCS] Adonis plugin loaded successfully")
end
]]></ProtectedString>
