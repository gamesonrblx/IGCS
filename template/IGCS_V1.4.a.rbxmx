 |_____\_____|\_____|_____/ 
                            
 IGCS ??In-Game Chat System

]]

-- INITALISE
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local StarterGuiService = game:GetService("StarterGui")

local igcsRoot = script.Parent
local content = igcsRoot:WaitForChild("Content")

local function must(parent: Instance, name: string): Instance
	local obj = parent:FindFirstChild(name)
	assert(obj, (`[IGCS Initialise] Missing "{name}" under {parent:GetFullName()}`))
	return obj
end

local function ensureFolder(parent: Instance, name: string): Folder
	local f = parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local r = parent:FindFirstChild(name)
	if not r then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = parent
	end
	return r
end

local function installClone(src: Instance, destParent: Instance, destName: string?)
	local clone = src:Clone()
	clone.Name = destName or src.Name

	local existing = destParent:FindFirstChild(clone.Name)
	if existing then
		existing:Destroy()
	end

	clone.Parent = destParent
	return clone
end

-- ===== Validate structure =====
local chatServerModule = must(content, "ChatServer.server") -- ModuleScript
local iconModule = must(content, "Icon") -- ModuleScript
local clientGui = must(content, "IGCS_Client") -- ScreenGui
local configModule = must(igcsRoot, "IGCSConfiguration") -- ModuleScript
local bridge = must(content, "IGCS_AdminBridge")

-- ===== Install to correct services =====
installClone(iconModule, ReplicatedStorage, "Icon")
installClone(iconModule, ReplicatedStorage, "IGCS_AdminBridge")
installClone(configModule, ReplicatedStorage, "IGCSConfiguration")
installClone(clientGui, StarterGui, "IGCS_Client")

-- ===== Create remotes (names can be configured later) =====
local remotes = ensureFolder(ReplicatedStorage, "IGCS_Remotes")
ensureRemoteEvent(remotes, "SendMessage")
ensureRemoteEvent(remotes, "BroadcastMessage")
ensureRemoteEvent(remotes, "WhisperMessage")

-- ===== Disable default Roblox chat UI (server-side) =====
StarterGuiService:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)

-- ===== Start chat server module =====
local ok, modOrErr = pcall(require, chatServerModule)
if not ok then
	warn("[IGCS Initialise] Failed to require ChatServer.server:", modOrErr)
	return
end

if type(modOrErr) == "table" and type(modOrErr.Start) == "function" then
	modOrErr.Start()
elseif type(modOrErr) == "function" then
	modOrErr()
else
	warn("[IGCS Initialise] ChatServer.server must return a table with Start() or a function.")
end

print("[IGCS Initialise] Installed IGCS assets + started server.")]]></ProtectedString>
